# Application runtime connection (Neon Pooled connection string)
DATABASE_URL="postgresql://USERNAME:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Prisma CLI and migration connection (Neon Direct unpooled connection string)
DATABASE_URL_UNPOOLED="postgresql://USERNAME:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

PORT=5000
NODE_ENV=development
# Explicit CORS allowlist (comma-separated, no wildcards when credentials: true)
CORS_ORIGINS=https://brightloop-billing.vercel.app,http://localhost:3000,http://localhost:5173

# Firebase Admin token verification project
FIREBASE_PROJECT_ID=your-firebase-project-id
# For Railway / cloud deployments, set the raw service account JSON string:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"..."}
# Or specify a local JSON file path for development:
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

BUSINESS_STATE_CODE=your-business-state-code
BUSINESS_TIMEZONE=Asia/Kolkata

# Automatic daily billing runs at the configured UTC time. Set false to pause it.
BILLING_WORKER_ENABLED=true
BILLING_RUN_UTC_HOUR=0
BILLING_RUN_UTC_MINUTE=5
